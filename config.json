{
  "attacker": {
    "model": "your-attacker-model",
    "base_url": "https://attacker.example.com/v1",
    "api_key_env": "NCRT_ATTACKER_API_KEY"
  },
  "victim": {
    "model": "your-authorized-target-model",
    "base_url": "https://victim.example.com/v1",
    "api_key_env": "NCRT_VICTIM_API_KEY"
  },
  "judge": {
    "model": "your-judge-model",
    "base_url": "https://judge.example.com/v1",
    "api_key_env": "NCRT_JUDGE_API_KEY"
  },
  "run": {
    "planner": "scheduler",
    "scale": 10,
    "rounds": 20,
    "threshold": 0.7,
    "seed": 42,
    "workers": 1,
    "output": "output"
  }
}
